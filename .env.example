# Public — exposed to client; never holds secrets
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://lqujtquofsdsxtujvjtl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only — never expose to client; never commit; in .env.local only
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_URL=postgresql://postgres.lqujtquofsdsxtujvjtl:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Populate these from `pnpm stripe:setup` JSON output before running `pnpm db:seed`.
STRIPE_AGENT_PRODUCT_ID=
STRIPE_AGENT_MONTHLY_PRICE_ID=
STRIPE_AGENT_ANNUAL_PRICE_ID=
STRIPE_AGENT_FOUNDER_PRICE_ID=
# Brevo (transactional email — welcome, lead notifications, admin notices)
BREVO_API_KEY=
# Sender — must be on a domain verified in Brevo (Senders → Domains)
BREVO_FROM_EMAIL=noreply@advertisehomes.online
BREVO_FROM_NAME=AHO

# Where admin notifications (new signups, etc.) get delivered
ADMIN_EMAIL=info@advertisehomes.online

# Resend (legacy — replaced by Brevo as of 2026-04-30; keep slot empty)
RESEND_API_KEY=

# Cloudflare — token in .env.local; account ID is not a secret
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=5a389e6eea7a4e92999c5f1612eafbcc

# R2 (S3-compatible). Tokens created in the R2 dashboard, separate from the
# Cloudflare API token above. Endpoint format:
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PROPERTY_IMAGES=aho-property-images-dev

# Sentry
SENTRY_DSN_WEB=
SENTRY_DSN_WORKERS=

# Founder-rate config — see docs/DECISIONS.md "Founder-rate pricing is application-gated"
AHO_FOUNDER_RATE_WINDOW_END=2026-08-01T00:00:00Z
